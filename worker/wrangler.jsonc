{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quartz-cloudflare-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "quartz-cloudflare-media",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "vars": {
    "IMAGE_WIDTHS": "640,1280,1920",
    "IMAGE_QUALITY": "88",
  },
  "secrets": {
    "required": ["UPLOAD_TOKEN"],
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
